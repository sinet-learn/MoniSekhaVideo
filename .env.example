# ==============================================================================
# MoniSekha Video Studio - Environment Configuration Template
# Copy this file to .env.local or .env and add your actual API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Orchestrator Keys
# Configure at least one provider (Gemini or Groq).
# You can set primary (1) and backup/secondary (2) keys switchable in the UI.
# ------------------------------------------------------------------------------
GEMINI_KEY_1=your_gemini_api_key_here
GEMINI_KEY_2=your_optional_gemini_backup_key_here

GROQ_KEY_1=your_groq_api_key_here
GROQ_KEY_2=your_optional_groq_backup_key_here

# ------------------------------------------------------------------------------
# Google Flow MCP Settings (Optional)
# Only required if using Google Flow for cloud image synthesis.
# ------------------------------------------------------------------------------
# FLOW_PROJECT_ID=your_flow_project_id_here
# GFLOW_PROFILE=cavepaint
# GFLOW_DAEMON_HOST=http://127.0.0.1:8765
# GFLOW_BIN=gflow

# ------------------------------------------------------------------------------
# VoxCPM Voice Engine Settings (Optional)
# Default is 'ravuthz/VoxCPM2-khmer' (Khmer fine-tuned weights on OpenBMB/VoxCPM)
# ------------------------------------------------------------------------------
VOXCPM_MODEL_NAME=ravuthz/VoxCPM2-khmer
