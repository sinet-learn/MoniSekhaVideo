# ==========================================
# Frontend (Next.js)
# ==========================================
**/node_modules/
**/.next/
frontend/out/
**/.pnpm-debug.log
*.tsbuildinfo

# ==========================================
# Backend (Python / FastAPI)
# ==========================================
# Bytecode and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environments
.venv/
venv/
env/

# Python packaging clutter
backend/develop-eggs/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/*.egg-info/

# Databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example

# Local machine runner
start.sh

# ==========================================
# Workspace Storage
# ==========================================
# Ignores all media assets generated locally
workspace/
!workspace/.gitkeep

# ==========================================
# Global / OS Overrides
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
MoniSekha.app/
